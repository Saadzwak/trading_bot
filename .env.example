# Copier vers .env (jamais committé — vérifié dans .gitignore), chmod 600.
# Freqtrade lit ces variables et surcharge la config (FREQTRADE__SECTION__CHAMP).

# --- UI locale (dry-run) : générés localement, à changer si vous voulez ---
FREQTRADE__API_SERVER__PASSWORD=changez-moi
FREQTRADE__API_SERVER__JWT_SECRET_KEY=changez-moi-aussi

# --- Telegram (à créer vous-même via @BotFather ; activer ensuite) ---
#FREQTRADE__TELEGRAM__ENABLED=true
#FREQTRADE__TELEGRAM__TOKEN=xxxx
#FREQTRADE__TELEGRAM__CHAT_ID=xxxx

# --- Clés Binance : UNIQUEMENT sur le VPS, UNIQUEMENT remplies par vous. ---
# Trading seul, retraits désactivés, IP whitelist — voir SECURITE_CLES_API.md.
# L'assistant ne doit JAMAIS voir ces valeurs.
#FREQTRADE__EXCHANGE__KEY=xxxx
#FREQTRADE__EXCHANGE__SECRET=xxxx

# --- Passage en réel : geste HUMAIN uniquement (Point de blocage 2). ---
# Sur le VPS seulement, après checklist + capture + kill-switch actif :
#FREQTRADE__DRY_RUN=false
