  "stake_amount": 1000,
  "dry_run_wallet": 10000,
  "max_open_trades": 10,
  "timeframe": "1h",
  "dataformat_ohlcv": "feather",
  "user_data_dir": "./user_data",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
